FROM node:24-bookworm-slim AS frontend
WORKDIR /src/frontend
COPY frontend/package*.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
RUN npm run build

FROM python:3.12-slim AS runtime
COPY --from=ghcr.io/astral-sh/uv:0.13.7 /uv /usr/local/bin/uv
WORKDIR /app
ENV PYTHONUNBUFFERED=1 LITELLM_LOCAL_MODEL_COST_MAP=True UV_LINK_MODE=copy
COPY pyproject.toml uv.lock README.md ./
COPY trendradar ./trendradar
COPY mcp_server ./mcp_server
COPY config ./config
RUN uv sync --frozen --no-dev
COPY --from=frontend /src/frontend/dist ./frontend/dist
RUN useradd --uid 10001 --create-home radar && mkdir -p output .run && chown -R radar:radar /app
USER radar
EXPOSE 8787
CMD [".venv/bin/python", "-m", "trendradar.workbench", "serve", "--host", "0.0.0.0", "--root", "/app"]
