# Copy to .env.local and fill in your BigModel API key.
# start-local.sh loads .env.local; never commit the real key.
AI_API_KEY=
AI_MODEL=openai/glm-5.3
AI_API_BASE=https://open.bigmodel.cn/api/paas/v4
# Coding Plan uses its own key and endpoint; subject to supported client access.
# AI_API_BASE=https://open.bigmodel.cn/api/coding/paas/v4
AI_ANALYSIS_ENABLED=true
AI_TRANSLATION_ENABLED=true
AI_TIMEOUT=180

# Local web workbench
WEB_PORT=8787
